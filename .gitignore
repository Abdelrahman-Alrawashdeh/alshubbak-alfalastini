# Raw source media (kept locally; the site uses the optimized copies in images/, videos/, posters/)
assets/*/originals/

# Deployment bundle generated by tools/build_cloudflare.py
cloudflare-upload/

# Local tooling (bundled Python packages, ffmpeg, Playwright driver) and review output
.tools/
.review/

# Secrets - never commit
.env*

# One-time local publish helper
publish-to-github.ps1

# OS / editor / Python
desktop.ini
Thumbs.db
.DS_Store
__pycache__/
*.pyc
